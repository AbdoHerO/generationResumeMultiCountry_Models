{
    "name": "abdohero/cv-builder-multi-country",
    "description": "Professional multi-country CV and resume builder (PHP, MySQL, vanilla JS, mPDF).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "mpdf/mpdf": "^8.2",
        "phpmailer/phpmailer": "^6.9",
        "smalot/pdfparser": "^2.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.12"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
