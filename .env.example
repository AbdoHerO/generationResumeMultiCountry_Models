# ResumeAtlas — copy to .env and adjust. Never commit a real .env.
APP_NAME=ResumeAtlas
# production | local | testing
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
# Random secret (base64:...). Generate with: php bin/console key:generate
APP_KEY=
APP_TIMEZONE=UTC

# MySQL 8+ (MariaDB 10.4+ also works for local development)
DB_HOST=127.0.0.1
DB_PORT=3306
# Optional unix socket (takes precedence over host/port when set)
DB_SOCKET=
DB_DATABASE=cvbuilder
DB_USERNAME=root
DB_PASSWORD=

# Run pending migrations and idempotent seeders automatically on the first request
# after a deployment (protected by a database lock). Set to false to migrate manually
# with: php bin/console migrate
AUTO_MIGRATE=true

# Bootstrap administrator (created once, idempotently). The password is hashed with
# password_hash() and must be changed at the first sign-in. In production, set a
# strong ADMIN_INITIAL_PASSWORD before the first boot.
ADMIN_EMAIL=admin@abdoucloud.com
ADMIN_INITIAL_PASSWORD=

# Sessions: "auto" marks the cookie Secure when the request arrives over HTTPS.
SESSION_SECURE=auto
SESSION_LIFETIME_MINUTES=120

# Password reset e-mails: disabled | log | smtp
MAIL_MAILER=disabled
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=ResumeAtlas

# Comma-separated proxy addresses whose X-Forwarded-For / X-Forwarded-Proto are trusted
TRUSTED_PROXIES=127.0.0.1,::1
